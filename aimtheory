-- DYNAMIC ARENA DETECTION
local function getTargetFolders()
    local arena = workspace:FindFirstChild(
        "AimTheoryArena"
    )

    if not arena then
        return {}, "WAITING"
    end

    local folders = {}

    local balls = arena:FindFirstChild("Targets")
    local bots = arena:FindFirstChild("Bots")

    if balls then
        table.insert(folders, balls)
    end

    if bots then
        table.insert(folders, bots)
    end

    if balls and bots then
        return folders, "MIXED"
    elseif balls then
        return folders, "BALLS"
    elseif bots then
        return folders, "BOTS"
    end

    return folders, "WAITING"
end

