local function slider(name, y, minV, maxV, initial, callback, fmt)
    create("TextLabel", {
        Position = UDim2.fromOffset(20, y),
        Size = UDim2.fromOffset(235, 18),
        BackgroundTransparency = 1,
        Text = name,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium
    }, panel)
    local valueLabel = create("TextLabel", {
        Position = UDim2.fromOffset(260, y),
        Size = UDim2.fromOffset(102, 18),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = C.accent,
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, panel)
    local hitbox = create("TextButton", {
        Position = UDim2.fromOffset(20, y + 21),
        Size = UDim2.fromOffset(342, 19),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Active = true
    }, panel)
    local track = create("Frame", {
        Position = UDim2.fromOffset(0, 7),
        Size = UDim2.new(1, 0, 0, 5),
        BackgroundColor3 = C.elevated,
        BorderSizePixel = 0
    }, hitbox)
    round(track, 3)
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0
    }, track)
    round(fill, 3)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = C.text,
        BorderSizePixel = 0
    }, track)
    round(knob, 7)
    local sliding = false
    local function update(value)
        value = math.clamp(value, minV, maxV)
        local a = (value - minV) / (maxV - minV)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.fromScale(a, 0.5)
        valueLabel.Text = string.format(fmt, value)
        callback(value)
    end
    local function fromMouse(x)
        local a = math.clamp(
            (x - hitbox.AbsolutePosition.X) / math.max(hitbox.AbsoluteSize.X, 1), 0, 1
        )
        update(minV + a * (maxV - minV))
    end
    connect(hitbox.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            fromMouse(input.Position.X)
        end
    end)
    connect(UIS.InputChanged, function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromMouse(input.Position.X)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    update(initial)
end
