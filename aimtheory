-- TARGET HIGHLIGHT
local function clearHighlight()
    if highlight then
        highlight:Destroy()
        highlight = nil
    end
end

local function updateHighlight(target)
    if not settings.showTarget or not target then
        clearHighlight()
        return
    end

    if highlight and highlight.Adornee == target then
        return
    end

    clearHighlight()

    highlight = Instance.new("Highlight")
    highlight.Name = "PrecisionTargetHighlight"
    highlight.Adornee = target
    highlight.FillColor = C.green
    highlight.OutlineColor = C.text
    highlight.FillTransparency = 0.65
    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = target
end

