local function slider(name, subText, y, minV, maxV, initial, callback, fmt)
    local card = frame(panel, 20, y, 380, 70, C.surface, 11)
    label(card, name, 14, 9, 250, 18, 12, C.text, true)
    label(card, subText, 14, 28, 256, 14, 10, C.muted)
    local value = label(card, "", 276, 12, 88, 22, 13, C.accent, true)
    value.TextXAlignment = Enum.TextXAlignment.Right

    local hit = create("TextButton", {
        Position = UDim2.fromOffset(14, 46), Size = UDim2.fromOffset(352, 22),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Active = true
    }, card)
    local track = frame(hit, 0, 8, 352, 5, C.elevated, 3)
    local fill = frame(track, 0, 0, 0, 5, C.accent, 3)
    local knob = frame(track, 0, -4, 13, 13, C.text, 7)
    local draggingSlider = false
    local function update(v)
        v = math.clamp(v, minV, maxV)
        local a = (v - minV) / (maxV - minV)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, -6, 0, -4)
        value.Text = string.format(fmt, v)
        callback(v)
    end
    local function fromX(x)
        local alpha = math.clamp((x - hit.AbsolutePosition.X)
            / math.max(hit.AbsoluteSize.X, 1), 0, 1)
        update(minV + alpha * (maxV - minV))
    end
    connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
            fromX(input.Position.X)
        end
    end)
    connect(UIS.InputChanged, function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            fromX(input.Position.X)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    update(initial)
end

