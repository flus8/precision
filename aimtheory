-- UNIVERSAL TARGET DETECTION
-- Select targets by their folder and object identity, not color.
-- Confirmed training targets: Workspace.AimTheoryArena.Targets.Target
local function validTarget(part, mode)
    if not part:IsA("BasePart") then
        return false
    end

    if part.Transparency >= 1 then
        return false
    end

    if mode == "BALLS" then
        -- The game's training objects are named "Target".
        -- Their Color may be changed to any RGB value.
        return part.Name == "Target"
    end

    if mode == "BOTS" then
        local name = part.Name:lower()
        if name:find("captop", 1, true)
            or name:find("capbottom", 1, true)
            or name == "humanoidrootpart" then
            return false
        end
        return true
    end

    return false
end

-- TARGET CENTER
local function getScreenPosition(part)
    local camera = workspace.CurrentCamera

    if not camera then
        return nil
    end

    local pos, visible =
        camera:WorldToViewportPoint(part.Position)

    if not visible or pos.Z <= 0 then
        return nil
    end

    return Vector2.new(pos.X, pos.Y)
end

-- FIND CLOSEST TARGET
local function findTarget()
    local folders, mode = getTargetFolders()

    if #folders == 0 then
        return nil, mode
    end

    local mouse = UIS:GetMouseLocation()
    local closest
    local bestScore = math.huge

    for _, folder in ipairs(folders) do
        local folderMode =
            folder.Name == "Bots"
            and "BOTS"
            or "BALLS"

        for _, part in ipairs(
            folder:GetDescendants()
        ) do

            if validTarget(part, folderMode)
                and part:IsDescendantOf(workspace) then

                local pos = getScreenPosition(part)

                if pos then
                    local distance =
                        (pos - mouse).Magnitude

                    if distance <= settings.fov then
                        local score = distance

                        if folderMode == "BOTS"
                            and part.Name:lower():find(
                                "head", 1, true
                            ) then

                            score *= 0.85
                        end

                        if part == currentTarget then
                            score *= 0.95
                        end

                        if score < bestScore then
                            closest = part
                            bestScore = score
                        end
                    end
                end
            end
        end
    end

    return closest, mode
end

-- TRACKING MOVEMENT
local function calculateMovement(
    targetPos, mousePos, dt
)
    dt = math.clamp(dt, 0.001, 0.05)

    local error = targetPos - mousePos
    local distance = error.Magnitude

    if distance < 1 then
        trackingVelocity = Vector2.zero
        remainder = Vector2.zero
        return Vector2.zero
    end

    local gain =
        35 + settings.smoothness * 100

    local desiredSpeed = math.min(
        settings.maxSpeed,
        distance * gain
    )

    local desiredVelocity =
        error.Unit * desiredSpeed

    local response = 1 - math.exp(
        -(35 + settings.smoothness * 90) * dt
    )

    trackingVelocity = trackingVelocity:Lerp(
        desiredVelocity,
        response
    )

    local movement = trackingVelocity * dt

    if movement.Magnitude > distance then
        movement = error
        trackingVelocity = Vector2.zero
    end

    movement += remainder

    local rounded = Vector2.new(
        math.round(movement.X),
        math.round(movement.Y)
    )

    remainder = movement - rounded

    return rounded
end

-- MAIN LOOP
local renderConnection = connect(
    RS.RenderStepped,
    function(dt)
        local mouse = UIS:GetMouseLocation()

        updateFOVCircle(mouse)

        local _, detectedMode = getTargetFolders()
        modeLabel.Text = detectedMode

        if not settings.enabled then
            resetTracking()
            clearHighlight()
            setStatus("DISABLED", C.muted)
            return
        end

        local holdingRMB = UIS:IsMouseButtonPressed(
            Enum.UserInputType.MouseButton2
        )

        if not holdingRMB then
            resetTracking()
            clearHighlight()
            setStatus("HOLD RMB", C.yellow)
            return
        end

        local newTarget, mode = findTarget()
        modeLabel.Text = mode

        if newTarget ~= currentTarget then
            currentTarget = newTarget
            acquiredAt = os.clock()
            trackingVelocity = Vector2.zero
            remainder = Vector2.zero
        end

        if not currentTarget then
            clearHighlight()

            setStatus(
                mode == "WAITING"
                    and "WAITING"
                    or "NO TARGET",
                C.red
            )

            return
        end

        updateHighlight(currentTarget)

        local targetPos =
            getScreenPosition(currentTarget)

        if not targetPos then
            clearHighlight()
            setStatus("OFF SCREEN", C.red)
            return
        end

        if os.clock() - acquiredAt
            < settings.reactionDelay then

            setStatus("ACQUIRING", C.yellow)
            return
        end

        if type(mousemoverel) ~= "function" then
            setStatus("API MISSING", C.red)
            return
        end

        local movement = calculateMovement(
            targetPos,
            mouse,
            dt
        )

        if movement.Magnitude > 0 then
            local ok = pcall(function()
                mousemoverel(
                    movement.X,
                    movement.Y
                )
            end)

            if not ok then
                setStatus("MOUSE ERROR", C.red)
                return
            end
        end

        setStatus("TRACKING", C.green)
    end
)

